
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Set to "ollama" to force all AI calls through your self-hosted Ollama instance.
# Leave unset/empty to use each user's own provider/API key (e.g. their Gemini key).
AI_PROVIDER=
# Database Settings
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_tutor

# Combined Connection String
DATABASE_URL="postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/ai_tutor"

# Shared with the NextAuth BFF (must match auth-bff/.env AUTH_SECRET)
AUTH_SECRET=change-me-shared-secret